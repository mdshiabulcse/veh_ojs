1818656034a:3:{s:6:"domain";N;s:12:"plural-forms";s:100:"nplurals=3; plural=n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2;";s:8:"messages";a:1:{s:0:"";a:51:{s:20:"admin.hostedContexts";s:19:"Časopisi u sustavu";s:23:"admin.settings.redirect";s:35:"Izravno preusmjeravanje na časopis";s:35:"admin.settings.redirectInstructions";s:160:"Svi upiti i posjeti glavnoj stranici bit će preusmjereni na odabrani časopis. To može biti izuzetno korisno ako je na sustavu postavljen samo jedan časopis.";s:30:"admin.languages.confirmDisable";s:120:"Jeste li sigurni da želite onemogućiti ovaj jezik? To može utjecati na sve časopise koji trenutno koriste taj jezik.";s:41:"admin.languages.primaryLocaleInstructions";s:81:"Ovo će biti standardni jezik stranice i svakog časopisa koji se na njoj nalazi.";s:44:"admin.languages.supportedLocalesInstructions";s:449:"Izaberite sve jezike za koje želite da budu podržani na stranici. Izabrane prijevode bit će moguće koristiti sa svim časopisima postavljenim u sustavu, te će se na svakoj stranici prikazivati i izbornik jezika (što se može uključiti ili isključiti na razini pojedinog časopisa). Ako je izabran samo jedan jezik, jezični izbornik se neće prikazivati, niti će glavnim urednicima pojedinih časopisa biti na raspolaganu jezične postavke.";s:28:"admin.locale.maybeIncomplete";s:42:"Označeni prijevodi su možda nezavršeni.";s:32:"admin.languages.confirmUninstall";s:120:"Jeste li sigurni da želite onemogućiti ovaj jezik? To može utjecati na sve časopise koji trenutno koriste taj jezik.";s:45:"admin.languages.installNewLocalesInstructions";s:291:"Izaberite bilo koji od ispod navedenih prijevoda kako biste instalirali podršku za taj jezik u sustavu. Prijevodi moraju biti instalirani prije nego što se mogu aktivirati i koristiti u pojedinim časopisima. Pogledajte OJS dokumentaciju za informacije o dodavanju podrške za nove jezike.";s:19:"admin.systemVersion";s:11:"OJS verzija";s:25:"admin.systemConfiguration";s:19:"Konfiguracija OJS-a";s:36:"admin.systemConfigurationDescription";s:65:"OJS konfiguracijske postavke iz <tt>config.inc.php</tt> datoteke.";s:33:"admin.journals.createInstructions";s:195:"Automatski ćete biti evidentirani kao glavni urednik ovog časopisa. Nakon što pokrenete novi časopis, pristupite mu kao glavni urednik kako biste nastavili s podešavanjem i upisom korisnika.";s:30:"admin.journals.journalSettings";s:18:"Postavke časopisa";s:26:"admin.journals.noneCreated";s:36:"Nijedan časopis još nije izrađen.";s:21:"admin.contexts.create";s:21:"Pokreni novi časopis";s:24:"admin.journals.urlWillBe";s:110:"Preporuča se jedna kratka riječ ili akronim koji identificira časopis. URL časopisa će biti {$sampleUrl}.";s:33:"admin.contexts.form.titleRequired";s:27:"Potrebno je unijeti naslov.";s:32:"admin.contexts.form.pathRequired";s:20:"Putanja je obavezna.";s:36:"admin.contexts.form.pathAlphaNumeric";s:110:"Putanja smije sadržavati samo slova, brojeve i znakove _ i -. Mora započeti i završiti s brojem ili slovom.";s:30:"admin.contexts.form.pathExists";s:59:"Putanja koju ste unijeli već se koristi za drugi časopis.";s:45:"admin.contexts.form.primaryLocaleNotSupported";s:65:"Primarni jezik mora biti jedan od jezika koje časopis podržava.";s:40:"admin.journals.enableJournalInstructions";s:54:"Omogućite ovom časopisu javnu dostupnost na stranici";s:33:"admin.contexts.contextDescription";s:14:"Opis časopisa";s:36:"admin.journal.pathImportInstructions";s:74:"Postojeća putanja časopisa ili putanja koju treba izraditi (npr. "ojs").";s:34:"admin.journals.importSubscriptions";s:30:"Uvezi pretplate i pretplatnike";s:24:"admin.journals.transcode";s:55:"Prekodiraj metapodatke prenesenih članaka iz ISO8859-1";s:23:"admin.journals.redirect";s:61:"Generiraj kod koji će mapirati OJS 1 URL-ove u OJS 2 URL-ove";s:38:"admin.journals.form.importPathRequired";s:26:"Putanja uvoza je obavezna.";s:27:"admin.journals.importErrors";s:28:"Uvoz nije uspješno dovršen";s:16:"admin.mergeUsers";s:15:"Spoji korisnike";s:26:"admin.mergeUsers.mergeUser";s:15:"Spoji korisnika";s:33:"admin.mergeUsers.into.description";s:117:"Odaberite korisnika kojem će se pripisati autorstva, urednička zaduženja i ostale aktivnosti prethodnog korisnika.";s:33:"admin.mergeUsers.from.description";s:276:"Odaberite jednog ili više korisnika kojeg ćete spojiti s drugim korisničkim računom (npr. u slučaju da neki korisnik posjeduje dva korisnička računa). Račun koji prvi odaberete bit će obrisan, a svi njegovi prilozi, zaduženja itd. bit će pridruženi drugom računu.";s:25:"admin.mergeUsers.allUsers";s:25:"Svi prijavljeni korisnici";s:24:"admin.mergeUsers.confirm";s:230:"Jeste li sigurni da želite spojiti račun korisnika "{$oldUsername}" s računom korisnika "{$newUsername}"? Račun korisničkog imena "{$oldUsername}" više neće postojati nakon toga. Ovu radnju nije moguće naknadno poništiti.";s:29:"admin.mergeUsers.noneEnrolled";s:28:"Nema prijavljenih korisnika.";s:46:"admin.scheduledTask.subscriptionExpiryReminder";s:29:"Podsjetnik o isteku pretplate";s:42:"admin.scheduledTask.openAccessNotification";s:30:"Obavijest o otvorenom pristupu";s:34:"admin.scheduledTask.reviewReminder";s:23:"Podsjetnik za recenziju";s:48:"admin.job.processLogFile.invalidLogEntry.issueId";s:37:"ID sveska časopisa nije cijeli broj.";s:54:"admin.job.processLogFile.invalidLogEntry.issueGalleyId";s:47:"ID prijeloma sveska časopisa nije cijeli broj.";s:74:"admin.scheduledTask.usageStatsLoader.invalidLogEntry.issueAssocTypeNoMatch";s:46:"ID sveska ne podudara se s pridruženim ID-om.";s:43:"admin.settings.enableBulkEmails.description";s:788:"Odaberite časopise kojima će biti dopušteno skupno slanje e-mailova. Kada je ova opcija omogućena, glavni urednik časopisa moći će poslati e-mail svim registriranim korisnicima u svom časopisu.<br><br>Zlouporaba ove mogućnosti za slanje neželjene e-pošte može predstavljati kršenje propisa o neželjenoj pošti u pojedinim jurisdikcijama te može dovesti do toga da e-pošta s vašeg poslužitelja bude blokirana kao neželjena. Prije aktivacije ove funkcije potražite tehnički savjet i razmotrite savjetovanje s glavnim urednikom časopisa ako bi se osigurala njezina primjerena uporaba.<br><br>Dodatna ograničenja ove funkcije mogu se omogućiti za svaki časopis putem njegovog čarobnjaka za postavke u popisu <a href="{$hostedContextsUrl}">Registrirani časopisi</a>.";s:48:"admin.settings.disableBulkEmailRoles.description";s:537:"Glavni časopisa neće moći slati skupne e-mailove nijednoj od uloga odabranih u nastavku. Ovu postavku koristite kako biste ograničili moguće zloupotrebe funkcije obavještavanja putem e-maila. Na primjer, sigurnije je onemogućiti masovno slanje e-mailova čitateljima, autorima ili drugim velikim skupinama korisnika koji nisu dali privolu za primanje takvih poruka.<br><br>Funkcija masovnog slanja e-mailova može se u potpunosti onemogućiti za ovaj časopis u odjeljku <a href="{$siteSettingsUrl}">Admin > Postavke stranice</a>.";s:52:"admin.settings.disableBulkEmailRoles.contextDisabled";s:162:"Funkcija skupnog slanja e-mailova onemogućena je za ovaj časopis. Omogućite ovu funkciju u odjeljku <a href="{$siteSettingsUrl}">Admin > Postavke stranice</a>.";s:32:"admin.siteManagement.description";s:107:"Dodajte, uredite ili uklonite časopise s ove stranice te upravljajte postavkama na razini cijele stranice.";s:41:"admin.settings.statistics.geo.description";s:555:"Odaberite vrstu geografskih statistika korištenja koje mogu prikupljati časopisi na ovoj stranici. Detaljnije geografske statistike mogu znatno povećati veličinu baze podataka i, u rijetkim slučajevima, narušiti anonimnost posjetitelja. Svaki časopis može zasebno konfigurirati ovu postavku, ali nikada ne može prikupljati detaljnije podatke od onih koji su ovdje omogućeni. Na primjer, ako stranica podržava samo državu i regiju, časopis može odabrati državu i regiju ili samo državu. Praćenje države, regije i grada neće biti moguće.";s:50:"admin.settings.statistics.institutions.description";s:327:"Omogućite institucionalne statistike ako želite da časopisi na ovoj stranici mogu prikupljati statistike korištenja prema institucijama. Da bi koristili ovu funkciju, časopisi će morati dodati instituciju i pripadajuće IP raspone. Omogućavanje institucionalnih statistika može znatno povećati veličinu baze podataka.";s:50:"admin.settings.statistics.sushi.public.description";s:357:"Odaberite hoće li SUSHI API krajnje točke biti javno dostupan za sve časopise na ovoj stranici. Ako omogućite javni pristup API-ju, pojedini časopisi mogu prebrisati ovu postavku i ograničiti pristup vlastitim statistikama. Međutim, ako onemogućite javni API na razini stranice, časopisi neće imati mogućnost omogućiti javni pristup svom API-ju.";s:59:"admin.settings.statistics.sushiPlatform.isSiteSushiPlatform";s:50:"Koristite stranicu kao platformu za sve časopise.";}}}